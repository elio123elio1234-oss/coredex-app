# Python environment for the CAD scripts (recreate with requirements.txt)
.venv/
__pycache__/
*.pyc

# PlatformIO build output
.pio/

# KiCad backups, locks and caches
*-backups/
*.lck
*.kicad_prl
fp-info-cache
~*.kicad_*

# scratch renders that are not part of a deliverable
mechanical/out/tmp/

# design-model render output: regenerated by band_id.py and render_id.py (about 30 MB)
mechanical/out_id/*.glb
mechanical/out_id/*.png
mechanical/out_id/_chrome/
mechanical/out_id/build.log
mechanical/out_id/render.log
mechanical/studio/harness.js
mechanical/studio/shots.json
mechanical/studio/shots_p.json
mechanical/studio/shots_v32.json

# premium side variant: same rule (band_premium.py + render_p.py regenerate it); p.json and band_p.step are kept
mechanical/out_p/*.glb
mechanical/out_p/*.png
mechanical/out_p/_chrome/
mechanical/out_p/build.log
mechanical/out_p/render.log

# main board: regenerated by make_schematic.py (the PDF, BOM, ERC report and the KiCad files are kept)
electronics/main_board/svg/
electronics/main_board/*.net
electronics/main_board/fp-info-cache

# v0.12.0 - ignores for the hardware folder: venv, build output and log, KiCad scratch files, heavy render output (v3.2, the premium variant), main-board plot/netlist scratch
