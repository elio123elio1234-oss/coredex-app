# Python environment for the CAD scripts (recreate with requirements.txt)
.venv/
__pycache__/
*.pyc

# PlatformIO build output
.pio/

# KiCad backups, locks and caches
*-backups/
*.lck
*.kicad_prl
fp-info-cache
~*.kicad_*

# scratch renders that are not part of a deliverable
mechanical/out/tmp/

# design-model render output: regenerated by band_id.py and render_id.py (about 30 MB)
mechanical/out_id/*.glb
mechanical/out_id/*.png
mechanical/out_id/_chrome/
mechanical/studio/harness.js
mechanical/studio/shots.json

