{
  "expo": {
    "name": "CYPHIX Medical",
    "slug": "cyphix-medical",
    "version": "0.27.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "cyphix",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cyphix.medical",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "CYPHIX connects to your ECG device over Bluetooth to record heart signals."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cyphix.medical",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "CYPHIX uses a photo only as your profile picture, so a clinician can confirm they are reading the right record. It stays on this device.",
          "cameraPermission": "CYPHIX uses the camera only to take your profile picture. It stays on this device."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "CYPHIX uses Face ID so you can open your own health record without typing your password."
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
