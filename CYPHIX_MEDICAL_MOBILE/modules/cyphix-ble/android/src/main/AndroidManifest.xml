<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Runtime BLE permissions are declared by the app (app.json android.permissions);
       this library manifest only marks the hardware requirement as optional so the
       app stays installable on BLE-less devices (simulator fallback exists). -->
  <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
</manifest>
